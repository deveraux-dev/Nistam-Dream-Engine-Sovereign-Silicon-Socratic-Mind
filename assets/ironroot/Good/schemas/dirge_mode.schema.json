    "ascending_allowed": { "type": "array", "items": { "type": "string" } },
    "descending_allowed": { "type": "array", "items": { "type": "string" } },
    "primary_tone": { "type": "string" },
    "secondary_tone": { "type": "string" },
    "signature_phrases": { "type": "array", "items": { "type": "array", "items": { "type": "string" } } },
    "ornaments": { "type": "array", "items": { "type": "string" } },
    "time_gate": { "type": "string" },
    "season_gate": { "type": "string" },
    "rasa_profile": { "type": "object" },
