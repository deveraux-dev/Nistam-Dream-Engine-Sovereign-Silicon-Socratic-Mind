{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Forge Glyph Script Cluster",
  "type": "object",
  "properties": {
    "script_id": { "type": "string" },
    "visible_layer": { "type": "string" },
    "phonetic_layer": { "type": "string" },
    "mnemonic_layer": { "type": "string" },
    "executable_layer": { "type": "object" },
    "glyphs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "glyph_id": { "type": "string" },
          "shape": { "type": "string" },
          "orientation": { "type": "string" },
          "color": { "type": "string" },
          "sound": { "type": "string" },
          "operator": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    },
    "parse_result": { "type": "object" }
  },
  "required": ["script_id", "glyphs", "parse_result"]
}
