#vixi:kit v1
# Broski's astrological starmap automaton & synesthetic dsp-modulation
# Anchored in Schaeffer's Typo-Morphology of Sound Objects and Laban Movement Analysis

# Define sound morphology mapping (Schaeffer)
schaeffer.mass     = signal(audio.sub_bass)        # Mass: low frequency pitch/noise content
schaeffer.dynamic  = signal(audio.rms)             # Dynamic: amplitude envelope
schaeffer.grain    = signal(audio.spectrum_high)   # Grain: micro-texture noise
schaeffer.allure   = signal(audio.beat_phase)      # Allure: micro-modulation frequency

# Define movement effort mapping (Laban)
laban.space        = direct   | indirect           # Space: sharp constellation focus vs floating nebula drift
laban.weight       = strong   | light              # Weight: copper-oxide thick border vs golden hair-line
laban.time         = sudden   | sustained          # Time: rapid oscilloscope jitter vs smooth cosmic spin
laban.flow         = bound    | free               # Flow: strict border clipping vs ectoplasmic trailing lines

# Dynamic Automata states matching OODA cycle
state listening {
  laban.space <- direct
  laban.weight <- light
  laban.time <- sudden
  laban.flow <- bound
  
  vibe_glow <- schaeffer.mass * 8000p
  vibe_shake <- schaeffer.grain * 2000p
}

state previewing {
  laban.space <- indirect
  laban.weight <- light
  laban.time <- sustained
  laban.flow <- free
  
  vibe_glow <- schaeffer.mass * 5000p
  vibe_shake <- schaeffer.allure * 4000p
}

state executing {
  laban.space <- direct
  laban.weight <- strong
  laban.time <- sudden
  laban.flow <- free
  
  vibe_glow <- schaeffer.dynamic * 9500p
  vibe_shake <- schaeffer.grain * 8500p
}

state sleep {
  laban.space <- indirect
  laban.weight <- light
  laban.time <- sustained
  laban.flow <- bound
  
  vibe_glow <- 1000p
  vibe_shake <- 0p
}

# Animation mode definitions (choreography layer)
# Each mode: trigger condition + rendering parameters

mode chladni {
  label      = "Chladni Cymatics"
  trigger    = schaeffer.mass > 7000p
  intensity  = (schaeffer.mass - 7000p) / 3000p
  harmonic_m = 3 + (schaeffer.mass / 5000p) % 2
  sand_light = [220, 210, 180]
  sand_dark  = [90, 75, 50]
  threshold  = 0.3
}

mode lissajous {
  label      = "Lissajous Beam"
  trigger    = schaeffer.dynamic > 5000p
  ratio_a    = 1
  ratio_b    = 2
  beam_color = [0x3E, 0xD8, 0xB0]
  intensity  = schaeffer.dynamic / 10000p
}

mode pentaract_rotor {
  label      = "5D Pentaract Spin"
  trigger    = laban.time == sudden
  speed      = 0.12
  intensity  = schaeffer.allure / 10000p
}

mode starlock {
  label      = "Constellation Starlock"
  trigger    = schaeffer.mass > 8500p
  snap_geo   = pentagram
  flash_color = [255, 215, 0]
  aura_color = [200, 50, 50]
}

mode electro_etch {
  label      = "Melchers Electro-Etch"
  trigger    = schaeffer.grain > 6000p
  spark_color = [255, 119, 0]
  teal_color = [0, 229, 163]
  arc_density = schaeffer.grain / 10000p
}

# Gate-footer conventions
gate contrast_min    = 4.5
gate hit_target_min  = mu(32)
gate runtime_parse   = forbidden
gate alloc_steady    = forbidden
gate float_in_ir     = forbidden
