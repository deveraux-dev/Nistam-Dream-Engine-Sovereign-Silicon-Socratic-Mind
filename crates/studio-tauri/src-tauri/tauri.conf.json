{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Forge V3 Demo Shell",
  "version": "0.3.0",
  "identifier": "com.forge.studio-tauri",
  "build": {
    "frontendDist": "../ui"
  },
  "bundle": {
    "icon": [
      "icons/icon.ico"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self' vixi:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-src 'self' vixi: blob: data:; img-src 'self' vixi: data:;"
    },
    "windows": [
      {
        "label": "main",
        "title": "Forge V3 Demo Shell",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ]
  }
}
