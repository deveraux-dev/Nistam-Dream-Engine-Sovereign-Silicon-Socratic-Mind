#vixi:shaderbind v1
# Technothesia audio -> vibe shader channels (Permyriad 0..10000). Loaded by the REAL
# parser forge_gpu::shaderbind_dsl::parse_shaderbind (closed audio set: rms / beat_phase /
# spectral_centroid). This is the §17.5 "SEE the audio" VibeUniforms face-wire: the MAPPING
# of which signal drives which vibe channel is AUTHORED here, not hardcoded in Rust.
#   ch0 -> vibe_glow   (rms, live now)
#   ch1 -> vibe_pulse  (beat_phase, live once R11 lands the groove)
#   ch2 -> reserved    (spectral_centroid, FFT is Branch-5)
#   ch3 -> light cascade (world.light_level, live now — 2026-07-14 SEE+HEAR dual:
#          lifts vibe_pulse AND scales the typed-note voice frequency, so the
#          cascade is heard rising as it is seen brightening)
#   ch4 -> vibe_shake  (term.route_margin, live now — the router's CERTAINTY about
#          the PTY chunk it just classified. The consumer shakes on its INVERSE:
#          a confident call holds the pane still, an uncertain one (T2-drain) makes
#          the sand stir, so the terminal shows its own doubt.)
surface: terminal
profile: seehear

signal rms      source=audio.rms                range=0..10000
signal beat     source=audio.beat_phase         range=0..10000
signal spectral source=audio.spectral_centroid  range=0..10000
signal light    source=world.light_level        range=0..10000
signal route    source=term.route_margin        range=0..10000

terminal.channel[0] <- rms
terminal.channel[1] <- beat
terminal.channel[2] <- spectral
terminal.channel[3] <- light
terminal.channel[4] <- route

gate shader_compile_hotpath = forbidden
gate visual_only_mutates_authority = forbidden
