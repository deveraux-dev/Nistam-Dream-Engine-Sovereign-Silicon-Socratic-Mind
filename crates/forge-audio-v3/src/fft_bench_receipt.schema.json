{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FFTBenchmarkReceipt",
  "type": "object",
  "required": [
    "engine",
    "transform_type",
    "hotpath_heap_bytes",
    "benchmarks",
    "accuracy",
    "barriers",
    "sha256_seal"
  ],
  "properties": {
    "engine": {
      "type": "object",
      "required": ["name", "version", "target_arch", "no_std"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "target_arch": { "type": "string" },
        "no_std": { "type": "boolean" }
      }
    },
    "transform_type": {
      "type": "string",
      "enum": ["RFFT_in_place", "C2C_in_place", "RFFT_out_of_place", "C2C_out_of_place"]
    },
    "hotpath_heap_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 0
    },
    "benchmarks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["size_n", "warmed_latency_ns", "cold_latency_ns"],
        "properties": {
          "size_n": { "type": "integer" },
          "warmed_latency_ns": { "type": "number" },
          "cold_latency_ns": { "type": "number" }
        }
      }
    },
    "accuracy": {
      "type": "object",
      "required": ["round_trip_mse", "snr_db", "test_vectors_passed"],
      "properties": {
        "round_trip_mse": { "type": "number" },
        "snr_db": { "type": "number" },
        "test_vectors_passed": { "type": "integer" }
      }
    },
    "barriers": {
      "type": "object",
      "required": ["black_box_enforced", "cache_sweep_mb"],
      "properties": {
        "black_box_enforced": { "type": "boolean" },
        "cache_sweep_mb": { "type": "integer" }
      }
    },
    "sha256_seal": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}
