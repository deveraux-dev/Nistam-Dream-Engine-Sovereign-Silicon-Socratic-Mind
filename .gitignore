**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.turbo/

# ------------------------------------------------------------------------------
# 4. Internal Engine Workspaces, Caches & Archives
# ------------------------------------------------------------------------------
.cache/
**/.cache/
*.cache
**/*.cache
# .forge/ is internal, EXCEPT the directives fixture that a shipped test reads:
# forge-foreman-v3 directives::tests::the_real_directives_file_parses walks up for it,
# and without it `cargo test --workspace` fails on a fresh clone.
.forge/*
!.forge/v3-directives.ron
_attic*/
_archive*/
_archive-2026-08-27/
.claude/
.claude
_proof/
_staging*/
_staging/
_quarry/
_tmp/
tmp/
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 5. Heavy Uncompressed & Intermediate Render Assets
# ------------------------------------------------------------------------------
*.bmp
**/*.bmp
*.raw
**/*.raw

# ------------------------------------------------------------------------------
# 6. Credentials, Keys & Secrets (Strict Zero-Leak)
# ------------------------------------------------------------------------------
.env
*.env
*.env.*
*.pem
*.key
*.pfx
*credentials*.json
*service_account*.json
service_account.json
*.id_ed25519
*.id_rsa

# ------------------------------------------------------------------------------
